{
	"compilerOptions": {
		"allowImportingTsExtensions": false,
		"lib": [
			"ES2023",
			"DOM",
			"DOM.Iterable"
		],
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"noEmit": true,
		"skipLibCheck": true,
		"strict": true,
		"target": "ES2022",
		"types": [
			"bun"
		]
	},
	"include": [
		"src",
		"tests",
		"changelog/**/*"
	]
}
